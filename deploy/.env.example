# Settings for deploy/compose.yaml. Copy to .env (never commit .env).

# User and group the container runs as; ./data must be writable by them.
PUID=1000
PGID=1000

# Data root inside the container (config generations, secrets, SQLite,
# direct certificate cache, audit log). Mapped to ./data by compose.
TLS_BROKER_DATA_DIR=/data

# Listen address. Keep it on loopback and put nginx in front.
TLS_BROKER_LISTEN=127.0.0.1:8080

# Comma-separated LDAP usernames that receive the admin role at login.
TLS_BROKER_ADMINS=

# Local break-glass administrator (works without LDAP). The password may be
# plain text or a bcrypt hash; in a bcrypt hash write every "$" as "$$" so
# compose does not treat it as a variable.
TLS_BROKER_LOCAL_ADMIN_USER=
TLS_BROKER_LOCAL_ADMIN_PASSWORD=

# debug, info, warn or error.
TLS_BROKER_LOG_LEVEL=info

# DEVELOPMENT ONLY: comma-separated DoH URLs replacing the public resolvers
# (Cloudflare, Google), e.g. a mockdoh server. Mocks the DNS gate; leave
# empty in production.
TLS_BROKER_DOH_ENDPOINTS=
